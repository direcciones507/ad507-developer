{
  "name": "@ad507/technology-agent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "dry-run": "node --import tsx src/dry-run.ts",
    "serve": "node runtime/main.mjs",
    "test:runtime": "node --test runtime/*.test.mjs",
    "owner:hash": "node runtime/hash-password.mjs"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
