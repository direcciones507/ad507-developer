# Dedicated AD507 Developer service. Reuse only the authorized DeepSeek key; never copy product DATABASE_URL or other secrets.
AD507_DATA_DIR=/data/ad507
AD507_HOST=127.0.0.1
PORT=8787
AD507_ORIGIN=http://127.0.0.1:8787
# Generate privately: node runtime/hash-password.mjs < password-manager-input
AD507_OWNER_PASSWORD_HASH=
AD507_PROVIDER=deepseek
AD507_LIVE_ENABLED=false
AD507_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
AD507_INPUT_MICROUSD_PER_TOKEN=0.3
AD507_OUTPUT_MICROUSD_PER_TOKEN=1.2
AD507_BUDGET_MICROUSD=1000000
AD507_LEVEIA_BUDGET_MICROUSD=1000000
AD507_JUNTA_BUDGET_MICROUSD=1000000
# Railway keeps panel/model orchestration; GitHub Actions owns disposable Docker execution.
AD507_CHECK_BACKEND=github-actions
AD507_SOURCE_MODE=github
# One fine-grained token, restricted to direcciones507/leveia, can serve these roles;
# alternatively set separate SOURCE/ACTIONS/LEVEIA tokens for least privilege.
AD507_GITHUB_TOKEN=
AD507_SOURCE_GITHUB_TOKEN=
AD507_ACTIONS_GITHUB_TOKEN=
AD507_LEVEIA_GITHUB_TOKEN=
# Each additional project has its OWN repository-only token (not inherited from LEVEIA).
AD507_PROJECT_DIRECCIONES507_GITHUB_TOKEN=
AD507_PROJECT_REPORTAPA_GITHUB_TOKEN=
AD507_PROJECT_EMPLEOS_PA_GITHUB_TOKEN=
# Workflow exists on main already; run its reviewed implementation branch without merging product main.
AD507_ACTIONS_REF=ad507/task-developer-runtime
# Use exact reviewed controller/workflow SHA. Railway defaults to RAILWAY_GIT_COMMIT_SHA.
AD507_ACTIONS_SHA=
# Remain disabled until owner confirms included minutes and GitHub spending stop.
AD507_ACTIONS_INCLUDED_ONLY_CONFIRMED=false
AD507_ACTIONS_MONTHLY_MINUTES=0
AD507_ACTIONS_PROJECT_MINUTES=30
AD507_ACTIONS_TASK_MINUTES=30
AD507_PUBLISH_ENABLED=false
# Legacy dedicated-host alternative only; not required on Railway:
AD507_LEVEIA_SOURCE=
AD507_SANDBOX_IMAGE=ad507-checks:reviewed
