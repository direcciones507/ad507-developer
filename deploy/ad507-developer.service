[Unit]
Description=AD507 Developer durable private controller
After=network.target docker.service
Requires=docker.service
[Service]
Type=simple
User=ad507
Group=ad507
WorkingDirectory=/opt/ad507/leveia/tools/ad507-agent
EnvironmentFile=/etc/ad507/developer.env
ExecStart=/usr/bin/node runtime/main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ad507
[Install]
WantedBy=multi-user.target
